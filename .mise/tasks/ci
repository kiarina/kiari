#!/usr/bin/env bash
#MISE description="Run CI checks (lint, test, build)"

set -euo pipefail

echo "🚀 Running CI checks..."

echo ""
echo "🔍 Step 1/3: Lint check..."
mise run lint

echo ""
echo "🧪 Step 2/3: Test..."
mise run test --coverage

echo ""
echo "🏗️  Step 3/3: Build check..."
mise run build

echo ""
echo "✅ All CI checks passed!"
